# Plantilla general de integracion para revisar todas las variables del proyecto.
# Para ejecutar una aplicacion, usar como base sender/.env.example o receiver/.env.example
# y crear el .env dentro de la carpeta de esa aplicacion.
# No usar RootManageSharedAccessKey en las aplicaciones.
# No subir .env al repositorio.

# Emisor: usar una politica SAS con permiso unicamente Send.
AZURE_SERVICE_BUS_SENDER_CONNECTION_STRING=CADENA_SAS_SEND_FICTICIA_NO_REAL

# Receptor: usar una politica SAS con permiso unicamente Listen.
AZURE_SERVICE_BUS_RECEIVER_CONNECTION_STRING=CADENA_SAS_LISTEN_FICTICIA_NO_REAL

AZURE_SERVICE_BUS_QUEUE_NAME=academic-messages-queue
