# Copiar este archivo como .env en cada aplicacion y completar localmente.
# No usar RootManageSharedAccessKey en las aplicaciones.
# No subir .env al repositorio.

# Emisor: usar una politica SAS con permiso unicamente Send.
AZURE_SERVICE_BUS_SENDER_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<send-policy>;SharedAccessKey=<send-key>

# Receptor: usar una politica SAS con permiso unicamente Listen.
AZURE_SERVICE_BUS_RECEIVER_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<listen-policy>;SharedAccessKey=<listen-key>

AZURE_SERVICE_BUS_QUEUE_NAME=academic-messages-queue

# -----------------------------------------------------------------------
# Version local usada actualmente en el proyecto (ver docs/francisco-azure-integracion.md):
# Azure Service Bus Emulator ejecutado con Docker, NO Azure real.
#
# El emulador expone una unica cadena de conexion local y estatica (no
# reproduce politicas SAS separadas de Send/Listen). Para las pruebas locales,
# tanto AZURE_SERVICE_BUS_SENDER_CONNECTION_STRING como
# AZURE_SERVICE_BUS_RECEIVER_CONNECTION_STRING deben apuntar a este mismo
# valor local mientras se trabaja contra el emulador:
#
# AZURE_SERVICE_BUS_SENDER_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# AZURE_SERVICE_BUS_RECEIVER_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# AZURE_SERVICE_BUS_QUEUE_NAME=academic-messages-queue
#
# Ver shared/azure-service-bus-emulator/ para la configuracion de Docker del
# emulador y shared/azure-service-bus-emulator/.env.example para sus propias
# variables (contrasena local de sqledge, ruta de Config.json).
# -----------------------------------------------------------------------
