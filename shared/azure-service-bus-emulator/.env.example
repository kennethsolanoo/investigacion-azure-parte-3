# Copiar este archivo como .env dentro de shared/azure-service-bus-emulator/
# antes de ejecutar docker compose. No subir el .env real al repositorio.

# Ruta al archivo de configuracion de entidades del emulador (cola incluida).
CONFIG_PATH=./config/Config.json

# Contrasena LOCAL para el contenedor sqledge (estado interno del emulador).
# Es una contrasena de un contenedor efimero en la maquina local, no es una
# credencial de Azure. Aun asi, no debe subirse un valor real al repositorio.
SQL_PASSWORD=CAMBIA_ESTA_CONTRASENA_LOCAL

# Aceptacion de la licencia de Azure SQL Edge y del emulador. Debe ser "Y"
# para poder iniciar los contenedores.
ACCEPT_EULA=Y
